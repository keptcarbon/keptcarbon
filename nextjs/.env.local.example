# Copy to .env.local (for standalone nextjs dev outside docker compose).
# Never commit the real .env.local.

DATABASE_URL=postgresql://postgres:postgres@localhost:4533/keptcarbon
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

GMAIL_USER=
GMAIL_APP_PASSWORD=
