# Copy to .env and fill in real values. Never commit the real .env.

# ── Host port overrides (only needed on a shared server where
#    the defaults below already collide with another project) ──
# NEXTJS_HOST_PORT=3000
# BACKEND_HOST_PORT=8000
# POSTGIS_HOST_PORT=4533

# ── Postgres / PostGIS ──────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=keptcarbon
DATABASE_URL=postgresql://postgres:postgres@postgis:5432/keptcarbon

# ── Next.js ──────────────────────────────────────
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=false
JWT_SECRET=

# LINE login
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:3000/api/auth/line/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Gmail (transactional email)
GMAIL_USER=
GMAIL_APP_PASSWORD=
