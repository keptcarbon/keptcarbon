# ─────────────────────────────────────────────────────────────
# Dev-stack additions for the SERVER's `.env`.
#
# These are extra keys, read by docker-compose.dev.yml — they do
# NOT replace anything in .env. Append them to the existing
# server .env (same file the prod stack already uses), fill in
# real values, then run:
#
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml \
#     up -d --build nextjs-dev backend-dev
#
# Using one shared .env (instead of a separate --env-file) avoids
# accidentally recreating the shared `postgis` container with the
# wrong POSTGRES_DB if it isn't already running.
# ─────────────────────────────────────────────────────────────

# Separate database inside the SAME keptcarbon-postgis container.
DEV_POSTGRES_DB=keptcarbon_dev

# postgres user/password stay the same as prod (POSTGRES_USER / POSTGRES_PASSWORD)
DEV_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgis:5432/keptcarbon_dev

DEV_NEXT_PUBLIC_BACKEND_API_URL=https://dev.keptcarbon.net/api/v1

# OAuth callback URLs registered separately in each provider's console
# (Google Cloud Console, LINE Developers, Facebook for Developers)
# for the dev.keptcarbon.net redirect URI.
DEV_GOOGLE_CALLBACK_URL=https://dev.keptcarbon.net/api/auth/google/callback
DEV_LINE_CALLBACK_URL=https://dev.keptcarbon.net/api/auth/line/callback
DEV_FACEBOOK_CALLBACK_URL=https://dev.keptcarbon.net/api/auth/facebook/callback
